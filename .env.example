# Copiá este archivo a .env y completá los valores reales.

# Puerto del servidor
PORT=3000

# development | production
NODE_ENV=development

# Secreto para firmar las cookies de sesión (JWT).
# OBLIGATORIO en producción. Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Client ID de Google OAuth (debe coincidir con el del botón en login.html).
GOOGLE_CLIENT_ID=458018892518-srtasi2s4u8d3av95uj3val41nvtcf6a.apps.googleusercontent.com

# Emails autorizados a entrar al panel (separados por coma).
ADMIN_EMAILS=manu348@gmail.com

# Hash bcrypt de la contraseña de admin (opcional).
# Si se deja vacío, el login por contraseña queda deshabilitado.
# Generá el hash con:  npm run hash -- "tu-contraseña"
ADMIN_PASSWORD_HASH=

# Duración de la sesión en horas
SESSION_TTL_HOURS=8

# Connection string de PostgreSQL para la lista de administradores.
# En Render se inyecta sola (ver render.yaml). En local, si se deja vacío,
# se usa un archivo data/admins.json (no persistente en producción).
DATABASE_URL=

# Email de aviso de pedidos (SendGrid HTTP API — Render free bloquea SMTP).
# 1) Cuenta en sendgrid.com  2) Verificá un "Single Sender" (ej. manu348@gmail.com)
# 3) Settings → API Keys → crear una (Mail Send) y pegarla acá.
# Si quedan vacías, los pedidos igual se guardan pero NO se manda email.
MAIL_FROM=manu348@gmail.com
SENDGRID_API_KEY=
